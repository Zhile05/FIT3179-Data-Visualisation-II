        },
        "y": {
          "field": "y",
          "type": "quantitative"
        },
        "text": {
          "field": "text"
        }
      }
    },
    {
      "data": {
        "url": "data/global_trend.csv",
        "format": {
          "type": "csv",
          "parse": {
            "year": "number",
            "emissions_gt": "number"
          }
        }
      },
      "transform": [
        {
          "filter": "datum.year === 2025"
        }
      ],
      "mark": {
        "type": "point",
        "filled": true,
        "color": "#496b8a",
        "size": 65
      },
      "encoding": {
        "x": {
          "field": "year",
          "type": "quantitative",
          "title": null,
          "scale": {
            "domain": [
              1990,
              2025
            ]
          },
          "axis": {
            "format": "d",
            "tickCount": 6,
            "grid": false
          }
        },
        "y": {
          "field": "emissions_gt",
          "type": "quantitative",
          "title": "Annual emissions (Gt CO₂e)",
          "scale": {
            "domain": [
              0,
              60
            ]
          },
          "axis": {
            "tickCount": 5,
            "format": ".0f"
          }
        }
      }
    }
  ],
  "usermeta": {
    "chart_number": 5,
    "sources": [
      "EDGAR 2026"
    ],
    "data_year": 2025,
