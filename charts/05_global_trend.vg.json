{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 350,
  "autosize": {
    "type": "fit",
    "contains": "padding",
    "resize": true
  },
  "padding": 8,
  "config": {
    "background": "#ffffff",
    "font": "Source Sans 3",
    "view": {
      "stroke": null
    },
    "axis": {
      "labelFontSize": 13,
      "titleFontSize": 13,
      "labelColor": "#435968",
      "titleColor": "#435968",
      "gridColor": "#e5edf1",
      "domain": false,
      "labelPadding": 7,
      "titlePadding": 12
    },
    "legend": {
      "orient": "bottom",
      "labelFontSize": 13,
      "titleFontSize": 13,
      "labelLimit": 180,
      "offset": 12,
      "titleLimit": 300
    }
  },
  "description": "Annual global greenhouse gas emissions from 1990 to 2025.",
  "layer": [
    {
      "data": {
        "url": "data/global_trend.csv",
        "format": {
          "type": "csv",
          "parse": {
            "year": "number",
            "emissions_gt": "number"
          }
        }
      },
      "mark": {
        "type": "area",
        "color": "#dceaf0",
        "opacity": 0.7
      },
      "encoding": {
        "x": {
          "field": "year",
          "type": "quantitative",
          "title": null,
          "scale": {
            "domain": [
              1990,
              2025
            ]
          },
          "axis": {
            "format": "d",
            "tickCount": 6,
            "grid": false
          }
        },
        "y": {
          "field": "emissions_gt",
          "type": "quantitative",
          "title": "Annual emissions (Gt CO₂e)",
          "scale": {
            "domain": [
              0,
              60
            ]
          },
          "axis": {
            "tickCount": 5,
            "format": ".0f"
          }
        }
      }
    },
    {
      "data": {
        "url": "data/global_trend.csv",
        "format": {
          "type": "csv",
          "parse": {
            "year": "number",
            "emissions_gt": "number"
          }
        }
      },
      "mark": {
        "type": "line",
        "color": "#496b8a",
        "strokeWidth": 3
      },
      "encoding": {
        "x": {
          "field": "year",
          "type": "quantitative",
          "title": null,
          "scale": {
            "domain": [
              1990,
              2025
            ]
          },
          "axis": {
            "format": "d",
            "tickCount": 6,
            "grid": false
          }
        },
        "y": {
          "field": "emissions_gt",
          "type": "quantitative",
          "title": "Annual emissions (Gt CO₂e)",
          "scale": {
            "domain": [
              0,
              60
            ]
          },
          "axis": {
            "tickCount": 5,
            "format": ".0f"
          }
        },
        "tooltip": [
          {
            "field": "year",
            "type": "quantitative",
            "title": "Year",
            "format": "d"
          },
          {
            "field": "emissions_gt",
            "type": "quantitative",
            "title": "Global total (Gt CO₂e)",
            "format": ".1f"
          }
        ]
      }
    },
    {
      "data": {
        "values": [
          {
            "year": 2009,
            "text": "Financial crisis"
          },
          {
            "year": 2020,
            "text": "COVID-19"
          }
        ]
      },
      "mark": {
        "type": "rule",
        "color": "#adbcc6",
        "strokeDash": [
          3,
          4
        ]
      },
      "encoding": {
        "x": {
          "field": "year",
          "type": "quantitative",
          "title": null,
          "scale": {
            "domain": [
              1990,
              2025
            ]
          },
          "axis": {
            "format": "d",
            "tickCount": 6,
            "grid": false
          }
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "year": 2009,
            "y": 57,
            "text": "Financial crisis"
          },
          {
            "year": 2020,
            "y": 57,
            "text": "COVID-19"
          }
        ]
      },
      "mark": {
        "type": "text",
        "fontSize": 12,
        "color": "#687c89",
        "dy": -1
      },
      "encoding": {
        "x": {
          "field": "year",
          "type": "quantitative",
          "title": null,
          "scale": {
            "domain": [
              1990,
              2025
            ]
          },
          "axis": {
            "format": "d",
            "tickCount": 6,
