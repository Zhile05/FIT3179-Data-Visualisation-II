{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 390,
  "autosize": {
    "type": "fit",
    "contains": "padding",
    "resize": false
  },
  "padding": {
    "left": 8,
    "right": 20,
    "top": 12,
    "bottom": 8
  },
  "config": {
    "background": "#ffffff",
    "font": "Source Sans 3",
    "view": {
      "stroke": null
    },
    "axis": {
      "labelFontSize": 14,
      "titleFontSize": 14,
      "labelColor": "#435968",
      "titleColor": "#435968",
      "gridColor": "#e5edf1",
      "domain": false,
      "labelPadding": 9,
      "titlePadding": 14
    },
    "legend": {
      "orient": "bottom",
      "labelFontSize": 14,
      "titleFontSize": 14,
      "labelLimit": 210,
      "offset": 12,
      "titleLimit": 340,
      "columnPadding": 20,
      "rowPadding": 10,
      "labelOffset": 8,
      "titlePadding": 10,
      "padding": 4
    }
  },
  "description": "Global emission ranks of seven major emitters at selected years. Ranks are computed across all EDGAR country entries.",
  "data": {
    "url": "data/emissions_ranks.csv",
    "format": {
      "type": "csv",
      "parse": {
        "year": "number",
        "rank": "number",
        "total_ghg_mt_co2e": "number"
      }
    }
  },
  "layer": [
    {
      "mark": {
        "type": "line",
        "strokeWidth": 3,
        "point": {
          "filled": true,
          "size": 65
        }
      },
      "encoding": {
        "x": {
          "field": "year",
          "type": "quantitative",
          "title": null,
          "axis": {
            "values": [
              1990,
              2000,
              2010,
              2020,
              2025
            ],
            "format": "d",
            "grid": false
          },
          "scale": {
            "domain": [
              1990,
              2027
            ]
          }
        },
        "y": {
          "field": "rank",
          "type": "quantitative",
          "title": "Global rank (1 = largest)",
          "scale": {
            "domain": [
              1,
              19
            ],
            "reverse": true
          },
          "axis": {
            "tickCount": 6,
            "format": "d"
          }
        },
        "color": {
          "field": "country",
          "type": "nominal",
          "scale": {
            "domain": [
              "Brazil",
              "China",
              "India",
              "Indonesia",
              "Iran",
              "Russia",
              "United States"
            ],
            "range": [
              "#4477bb",
              "#cc4466",
              "#993366",
              "#2255aa",
              "#882288",
              "#775500",
              "#444444"
            ]
          },
          "legend": null
        },
        "tooltip": [
          {
            "field": "country",
            "title": "Country"
          },
          {
            "field": "year",
            "type": "quantitative",
            "title": "Year",
            "format": "d"
          },
          {
            "field": "rank",
            "type": "quantitative",
            "title": "Global rank",
            "format": "d"
          }
        ],
        "strokeDash": {
          "field": "country",
          "type": "nominal",
          "scale": {
            "domain": [
              "Brazil",
              "China",
              "India",
              "Indonesia",
              "Iran",
              "Russia",
              "United States"
            ],
            "range": [
              [
                1,
                0
              ],
              [
                6,
                3
              ],
              [
                2,
                3
              ],
              [
                9,
                3,
                2,
                3
              ],
              [
                9,
                3,
                2,
                3,
                2,
                3
              ],
              [
                12,
                4
              ],
              [
                4,
                2,
                1,
                2
              ]
            ]
          },
          "legend": null
        }
      }
    },
    {
      "transform": [
        {
          "filter": "datum.year === 2025"
        }
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 6,
        "fontSize": 13,
        "color": "#19374b"
      },
      "encoding": {
        "x": {
          "field": "year",
          "type": "quantitative",
          "title": null,
          "axis": {
            "values": [
              1990,
              2000,
              2010,
              2020,
              2025
            ],
            "format": "d",
            "grid": false
          },
          "scale": {
            "domain": [
              1990,
              2027
            ]
          }
        },
        "y": {
          "field": "rank",
          "type": "quantitative",
          "title": "Global rank (1 = largest)",
          "scale": {
            "domain": [
              1,
              19
            ],
            "reverse": true
          },
          "axis": {
            "tickCount": 6,
            "format": "d"
          }
        },
        "text": {
          "field": "country"
        }
      }
    }
  ],
  "usermeta": {
    "chart_number": 7,
    "sources": [
      "EDGAR 2026"
    ],
    "data_year": 2025,
    "specification_file": "charts/07_emissions_rank_bump.vg.json"
  }
}
