{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 410,
  "autosize": {
    "type": "fit",
    "contains": "padding",
    "resize": false
  },
  "padding": {
    "left": 32,
    "right": 16,
    "top": 12,
    "bottom": 8
  },
  "config": {
    "background": "#ffffff",
    "font": "Source Sans 3",
    "view": {
      "stroke": null
    },
    "axis": {
      "labelFontSize": 14,
      "titleFontSize": 14,
      "labelColor": "#435968",
      "titleColor": "#435968",
      "gridColor": "#e5edf1",
      "domain": false,
      "labelPadding": 9,
      "titlePadding": 14
    },
    "legend": {
      "orient": "bottom",
      "labelFontSize": 14,
      "titleFontSize": 14,
      "labelLimit": 210,
      "offset": 12,
      "titleLimit": 340,
      "columnPadding": 20,
      "rowPadding": 10,
      "labelOffset": 8,
      "titlePadding": 10,
      "padding": 4
    }
  },
  "description": "Malaysia emission growth from 1990 to 2025, decomposed into changes in eight sectors.",
  "data": {
    "url": "data/malaysia_sector_changes.csv",
    "format": {
      "type": "csv",
      "parse": {
        "start": "number",
        "end": "number",
        "amount": "number",
        "order": "number"
      }
    }
  },
  "layer": [
    {
      "mark": {
        "type": "bar",
        "size": 23,
        "cornerRadius": 2
      },
      "encoding": {
        "x": {
          "field": "start",
          "type": "quantitative",
          "title": "Annual emissions and changes (Mt CO₂e)",
          "scale": {
            "domain": [
              0,
              370
            ],
            "nice": false
          },
          "axis": {
            "tickCount": 5,
            "format": ".0f"
          }
        },
        "x2": {
          "field": "end"
        },
        "y": {
          "field": "label",
          "type": "nominal",
          "sort": {
            "field": "order",
            "order": "ascending"
          },
          "title": null,
          "axis": {
            "grid": false,
            "labelLimit": 150
          }
        },
        "color": {
          "field": "kind",
          "type": "nominal",
          "scale": {
            "domain": [
              "Total",
              "Increase",
              "Decrease"
            ],
            "range": [
              "#24485f",
              "#496b8a",
              "#a84420"
            ]
          },
          "legend": {
            "title": null,
            "symbolSize": 144,
            "columns": {
              "expr": "width < 400 ? 2 : 3"
            }
          }
        },
        "tooltip": [
          {
            "field": "label",
            "title": "Total / sector"
          },
          {
            "field": "amount",
            "type": "quantitative",
            "title": "Total or change (Mt CO₂e)",
            "format": ".1f"
          }
        ]
      }
    },
    {
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 6,
        "fontSize": 13,
        "color": "#24485f"
      },
      "encoding": {
        "x": {
          "field": "end",
          "type": "quantitative",
          "title": "Annual emissions and changes (Mt CO₂e)",
          "scale": {
            "domain": [
              0,
              370
            ],
            "nice": false
          },
          "axis": {
            "tickCount": 5,
            "format": ".0f"
          }
        },
        "y": {
          "field": "label",
          "type": "nominal",
          "sort": {
            "field": "order",
            "order": "ascending"
          },
          "title": null,
          "axis": {
            "grid": false,
            "labelLimit": 150
          }
        },
        "text": {
          "field": "amount_label"
        }
      }
    }
  ],
  "usermeta": {
    "chart_number": 10,
    "sources": [
      "EDGAR 2026"
    ],
    "data_year": 2025,
    "specification_file": "charts/10_malaysia_sectors_waterfall.vg.json"
  }
}
