{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 370,
  "autosize": {
    "type": "fit",
    "contains": "padding",
    "resize": true
  },
  "padding": 8,
  "config": {
    "background": "#ffffff",
    "font": "Source Sans 3",
    "view": {
      "stroke": null
    },
    "axis": {
      "labelFontSize": 13,
      "titleFontSize": 13,
      "labelColor": "#435968",
      "titleColor": "#435968",
      "gridColor": "#e5edf1",
      "domain": false,
      "labelPadding": 7,
      "titlePadding": 12
    },
    "legend": {
      "orient": "bottom",
      "labelFontSize": 13,
      "titleFontSize": 13,
      "labelLimit": 180,
      "offset": 12,
      "titleLimit": 300
    }
  },
  "description": "Malaysia emission growth from 1990 to 2025, decomposed into changes in eight sectors.",
  "data": {
    "url": "data/malaysia_waterfall.csv",
    "format": {
      "type": "csv",
      "parse": {
        "start": "number",
        "end": "number",
        "amount": "number",
        "order": "number"
      }
    }
  },
  "layer": [
    {
      "mark": {
        "type": "bar",
        "size": 19,
        "cornerRadius": 2
      },
      "encoding": {
        "x": {
          "field": "start",
          "type": "quantitative",
          "title": "Annual emissions and changes (Mt CO₂e)",
          "scale": {
            "domain": [
              0,
              421.60143470718754
            ]
          },
          "axis": {
            "tickCount": 5,
            "format": ".0f"
          }
        },
        "x2": {
          "field": "end"
        },
        "y": {
          "field": "label",
          "type": "nominal",
          "sort": {
            "field": "order",
            "order": "ascending"
          },
          "title": null,
          "axis": {
            "grid": false,
            "labelLimit": 125
          }
        },
        "color": {
          "field": "kind",
          "type": "nominal",
          "scale": {
            "domain": [
              "Total",
              "Increase",
              "Decrease"
            ],
            "range": [
              "#24485f",
              "#157f8d",
              "#d65f36"
            ]
          },
          "legend": {
            "title": null
          }
        },
        "tooltip": [
          {
            "field": "label",
            "title": "Total / sector"
          },
          {
            "field": "amount",
            "type": "quantitative",
            "title": "Total or change (Mt CO₂e)",
            "format": ".1f"
          }
        ]
      }
    },
    {
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 6,
        "fontSize": 12,
        "color": "#24485f"
      },
      "encoding": {
        "x": {
          "field": "end",
          "type": "quantitative",
          "title": "Annual emissions and changes (Mt CO₂e)",
          "scale": {
            "domain": [
              0,
              421.60143470718754
            ]
          },
          "axis": {
            "tickCount": 5,
            "format": ".0f"
          }
        },
        "y": {
          "field": "label",
          "type": "nominal",
          "sort": {
            "field": "order",
            "order": "ascending"
          },
          "title": null,
          "axis": {
            "grid": false,
            "labelLimit": 125
          }
        },
        "text": {
          "field": "amount_label"
        }
      }
    }
  ],
  "usermeta": {
    "chart_number": 10,
    "sources": [
      "EDGAR 2026"
    ],
    "data_year": 2025,
    "specification_file": "js/10_malaysia_waterfall.vg.json"
  }
}
